rules_version = '2';

// Generated by npm run rules:build. Edit this template, not firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSchoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches(__DOMAIN_PATTERN__);
    }

    function canReadContent() {
      return __PUBLIC_READ__ || isSchoolAccount();
    }

    function isTeacher() {
      return isSchoolAccount()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.isAdmin == true;
    }

    function validTeacher() {
      return request.resource.data.keys().hasAll(['name', 'isAdmin', 'addedBy', 'addedAt'])
        && request.resource.data.keys().hasOnly(['name', 'isAdmin', 'addedBy', 'addedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.isAdmin is bool
        && request.resource.data.addedBy is string
        && request.resource.data.addedAt is timestamp;
    }

    function validBook(bookId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'title', 'description', 'level', 'topicId', 'topicName', 'edition',
          'fileType', 'fileName', 'fileSize', 'storagePath', 'uploadedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'level', 'topicId', 'topicName', 'edition',
          'fileType', 'fileName', 'fileSize', 'storagePath', 'uploadedBy',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 1000
        && data.level in ['F1', 'F2', 'F3', 'F4', 'F5', 'F6']
        && data.topicId is string && data.topicName is string
        && data.topicName.size() > 0 && data.topicName.size() <= 160
        && exists(/databases/$(database)/documents/topics/$(data.topicId))
        && get(/databases/$(database)/documents/topics/$(data.topicId)).data.levels.hasAny([data.level])
        && data.edition in ['student', 'teacher']
        && data.fileType in ['pdf', 'docx', 'html']
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.fileSize is int && data.fileSize > 0 && data.fileSize <= 20 * 1024 * 1024
        && data.storagePath == 'mistake-books/' + data.edition + '/' + bookId + '/' + bookId + '.' + data.fileType
        && data.uploadedBy is map
        && data.uploadedBy.keys().hasAll(['uid', 'email', 'name'])
        && data.uploadedBy.keys().hasOnly(['uid', 'email', 'name'])
        && data.uploadedBy.uid is string && data.uploadedBy.uid.size() > 0
        && data.uploadedBy.email is string && data.uploadedBy.name is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validSiteContent(pageId) {
      let data = request.resource.data;
      return pageId == 'home'
        && data.keys().hasAll(['heroTitle', 'intro', 'announcement', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['heroTitle', 'intro', 'announcement', 'updatedBy', 'updatedAt'])
        && data.heroTitle is string && data.heroTitle.size() > 0 && data.heroTitle.size() <= 100
        && data.intro is string && data.intro.size() > 0 && data.intro.size() <= 500
        && data.announcement is map
        && data.announcement.keys().hasAll(['text', 'link', 'active'])
        && data.announcement.keys().hasOnly(['text', 'link', 'active'])
        && data.announcement.text is string && data.announcement.text.size() <= 300
        && data.announcement.link is string && data.announcement.link.size() <= 300
        && (data.announcement.link == ''
          || data.announcement.link == '/'
          || data.announcement.link.matches('^/[^/].*$')
          || data.announcement.link.matches('^https://[^ ]+$'))
        && data.announcement.active is bool
        && (!data.announcement.active || data.announcement.text.size() > 0)
        && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    function validAppSetting(slug) {
      let data = request.resource.data;
      return slug.matches('^[a-z0-9][a-z0-9-]{0,63}$')
        && data.keys().hasAll(['title', 'summary', 'featured', 'visible', 'order', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['title', 'summary', 'featured', 'visible', 'order', 'updatedBy', 'updatedAt'])
        && data.title is string && data.title.size() <= 100
        && data.summary is string && data.summary.size() <= 400
        && data.featured is bool && data.visible is bool
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    function validChallengeSettings(settings, kind) {
      return settings is map
        && settings.keys().hasAll(['skills','level','questionCount','timeLimitSec','scoring','order','maxAttempts','showNames'])
        && settings.keys().hasOnly(['skills','level','questionCount','timeLimitSec','scoring','order','maxAttempts','showNames'])
        && settings.skills is list && settings.skills.size() > 0 && settings.skills.size() <= 7
        && settings.skills.hasOnly(['numberLine','addSubtract','brackets','signs','mixed','wordProblems','mistakes'])
        && settings.level in [1,2] && settings.questionCount in [5,10,15,20]
        && (settings.timeLimitSec == null || (settings.timeLimitSec is int && settings.timeLimitSec >= 60 && settings.timeLimitSec <= 900))
        && settings.scoring in ['directed','gentle'] && settings.order in ['same','shuffled']
        && settings.maxAttempts is int && settings.maxAttempts >= 1
        && settings.maxAttempts <= (kind == 'live' ? 3 : 5)
        && settings.showNames in ['all','top10','avatars'];
    }

    function validChallengeRoomCreate(roomId) {
      let data = request.resource.data;
      return data.keys().hasAll(['code','appSlug','title','kind','settings','seed','classTag','season','status','opensAt','closesAt','createdBy','createdAt','expireAt','playerCount'])
        && data.keys().hasOnly(['code','appSlug','title','kind','settings','seed','classTag','season','status','opensAt','closesAt','createdBy','createdAt','expireAt','playerCount'])
        && data.code is string && data.code.matches('^[A-HJ-KM-NP-Z2-9]{6}$')
        && data.appSlug == 'directed-numbers' && data.title is string && data.title.size() > 0 && data.title.size() <= 60
        && data.kind in ['live','homework'] && validChallengeSettings(data.settings,data.kind)
        && data.seed is int && data.seed >= 0 && data.seed < 16777216
        && (data.classTag == null || (data.classTag is string && data.classTag.matches('^[1-6][A-F]$')))
        && data.season is string && data.season.matches('^[0-9]{4}-[0-9]{2}-T[12]$')
        && data.status == (data.kind == 'live' ? 'lobby' : 'live')
        && data.opensAt is timestamp && data.closesAt is timestamp && data.closesAt > data.opensAt
        && data.createdBy == request.auth.token.email && data.createdAt is timestamp
        && data.expireAt == data.closesAt + duration.value(60,'d')
        && data.playerCount == 0
        && getAfter(/databases/$(database)/documents/roomCodes/$(data.code)).data.roomId == roomId;
    }

    function validChallengeRoomUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(['title','status','closesAt','expireAt','settings'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 60
        && data.status in ['lobby','live','closed']
        && (resource.data.status == 'lobby' && data.status in ['lobby','live','closed']
          || resource.data.status == 'live' && data.status in ['live','closed']
          || resource.data.status == 'closed' && data.status == 'closed')
        && data.closesAt is timestamp && data.expireAt == data.closesAt + duration.value(60,'d')
        && validChallengeSettings(data.settings,data.kind)
        && data.settings.diff(resource.data.settings).affectedKeys().hasOnly(['showNames']);
    }

    function validRoomCode(code) {
      let data = request.resource.data;
      return data.keys().hasAll(['roomId','expireAt']) && data.keys().hasOnly(['roomId','expireAt'])
        && data.roomId is string && data.roomId.matches('^[A-Za-z0-9]{10,30}$')
        && data.expireAt is timestamp
        && getAfter(/databases/$(database)/documents/rooms/$(data.roomId)).data.code == code
        && getAfter(/databases/$(database)/documents/rooms/$(data.roomId)).data.expireAt == data.expireAt;
    }

    match /teachers/{email} {
      allow get: if isAdmin() || (isSchoolAccount() && email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if isAdmin() && email.matches(__DOMAIN_PATTERN__) && validTeacher();
      allow update: if isAdmin() && email.matches(__DOMAIN_PATTERN__) && validTeacher()
        && (email != request.auth.token.email || request.resource.data.isAdmin == true);
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /topics/{topicId} {
      allow read: if canReadContent();
      allow write: if isTeacher();
    }

    match /siteContent/{pageId} {
      allow read: if canReadContent();
      allow create, update: if isTeacher() && validSiteContent(pageId);
      allow delete: if false;
    }

    match /appSettings/{slug} {
      allow read: if canReadContent();
      allow create, update: if isTeacher() && validAppSetting(slug);
      allow delete: if false;
    }

    match /mistakeBooks/{bookId} {
      allow get, list: if isTeacher()
        || (canReadContent() && resource.data.edition == 'student');
      allow create: if isTeacher() && validBook(bookId)
        && request.resource.data.uploadedBy.uid == request.auth.uid
        && request.resource.data.uploadedBy.email == request.auth.token.email;
      allow update: if isTeacher() && validBook(bookId)
        && request.resource.data.edition == resource.data.edition
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isTeacher();
    }

    match /rooms/{roomId} {
      allow get: if canReadContent();
      allow list: if isTeacher();
      allow create: if isTeacher() && validChallengeRoomCreate(roomId);
      allow update: if isTeacher() && validChallengeRoomUpdate();
      allow delete: if isTeacher();

      match /entries/{uid} {
        allow get, list: if canReadContent();
        allow delete: if isTeacher();
        allow create, update: if false;
      }
      match /private/{uid} {
        allow get, list: if isTeacher();
        allow write: if false;
      }
      match /runs/{runId} {
        allow read, write: if false;
      }
      match /stats/{docId} {
        allow get, list: if isTeacher();
        allow write: if false;
      }
    }

    match /roomCodes/{code} {
      allow get: if canReadContent();
      allow list: if false;
      allow create: if isTeacher() && validRoomCode(code);
      allow update: if false;
      allow delete: if isTeacher();
    }

    match /classBoards/{boardId} {
      allow get, list: if canReadContent();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
