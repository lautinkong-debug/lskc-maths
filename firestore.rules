rules_version = '2';

// ---------------------------------------------------------------------------
// PLACEHOLDER - Phase 0.
//
// From Phase 2 onward this file is GENERATED by `npm run rules:build` from
// rules/firestore.rules.template, which substitutes NEXT_PUBLIC_ACCESS_MODE
// and NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS. Do not hand-edit it after that.
//
// Until then it denies everything, which is the safe default: the emulator
// starts, and nothing can be read or written by accident.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
