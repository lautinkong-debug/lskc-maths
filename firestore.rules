rules_version = '2';

// Generated by npm run rules:build. Edit this template, not firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSchoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches("^[^@]+@(lskc\\.edu\\.hk)$");
    }

    function canReadContent() {
      return true || isSchoolAccount();
    }

    function isTeacher() {
      return isSchoolAccount()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.isAdmin == true;
    }

    function validTeacher() {
      return request.resource.data.keys().hasAll(['name', 'isAdmin', 'addedBy', 'addedAt'])
        && request.resource.data.keys().hasOnly(['name', 'isAdmin', 'addedBy', 'addedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.isAdmin is bool
        && request.resource.data.addedBy is string
        && request.resource.data.addedAt is timestamp;
    }

    function validBook(bookId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'title', 'description', 'level', 'topicId', 'topicName', 'edition',
          'fileType', 'fileName', 'fileSize', 'storagePath', 'uploadedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'level', 'topicId', 'topicName', 'edition',
          'fileType', 'fileName', 'fileSize', 'storagePath', 'uploadedBy',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 1000
        && data.level in ['F1', 'F2', 'F3', 'F4', 'F5', 'F6']
        && data.topicId is string && data.topicName is string
        && data.topicName.size() > 0 && data.topicName.size() <= 160
        && exists(/databases/$(database)/documents/topics/$(data.topicId))
        && get(/databases/$(database)/documents/topics/$(data.topicId)).data.levels.hasAny([data.level])
        && data.edition in ['student', 'teacher']
        && data.fileType in ['pdf', 'docx', 'html']
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.fileSize is int && data.fileSize > 0 && data.fileSize <= 20 * 1024 * 1024
        && data.storagePath == 'mistake-books/' + data.edition + '/' + bookId + '/' + bookId + '.' + data.fileType
        && data.uploadedBy is map
        && data.uploadedBy.keys().hasAll(['uid', 'email', 'name'])
        && data.uploadedBy.keys().hasOnly(['uid', 'email', 'name'])
        && data.uploadedBy.uid is string && data.uploadedBy.uid.size() > 0
        && data.uploadedBy.email is string && data.uploadedBy.name is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validSiteContent(pageId) {
      let data = request.resource.data;
      return pageId == 'home'
        && data.keys().hasAll(['heroTitle', 'intro', 'announcement', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['heroTitle', 'intro', 'announcement', 'updatedBy', 'updatedAt'])
        && data.heroTitle is string && data.heroTitle.size() > 0 && data.heroTitle.size() <= 100
        && data.intro is string && data.intro.size() > 0 && data.intro.size() <= 500
        && data.announcement is map
        && data.announcement.keys().hasAll(['text', 'link', 'active'])
        && data.announcement.keys().hasOnly(['text', 'link', 'active'])
        && data.announcement.text is string && data.announcement.text.size() <= 300
        && data.announcement.link is string && data.announcement.link.size() <= 300
        && (data.announcement.link == ''
          || data.announcement.link == '/'
          || data.announcement.link.matches('^/[^/].*$')
          || data.announcement.link.matches('^https://[^ ]+$'))
        && data.announcement.active is bool
        && (!data.announcement.active || data.announcement.text.size() > 0)
        && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    function validAppSetting(slug) {
      let data = request.resource.data;
      return slug.matches('^[a-z0-9][a-z0-9-]{0,63}$')
        && data.keys().hasAll(['title', 'summary', 'featured', 'visible', 'order', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['title', 'summary', 'featured', 'visible', 'order', 'updatedBy', 'updatedAt'])
        && data.title is string && data.title.size() <= 100
        && data.summary is string && data.summary.size() <= 400
        && data.featured is bool && data.visible is bool
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.updatedBy == request.auth.token.email
        && data.updatedAt is timestamp;
    }

    match /teachers/{email} {
      allow get: if isAdmin() || (isSchoolAccount() && email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if isAdmin() && email.matches("^[^@]+@(lskc\\.edu\\.hk)$") && validTeacher();
      allow update: if isAdmin() && email.matches("^[^@]+@(lskc\\.edu\\.hk)$") && validTeacher()
        && (email != request.auth.token.email || request.resource.data.isAdmin == true);
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /topics/{topicId} {
      allow read: if canReadContent();
      allow write: if isTeacher();
    }

    match /siteContent/{pageId} {
      allow read: if canReadContent();
      allow create, update: if isTeacher() && validSiteContent(pageId);
      allow delete: if false;
    }

    match /appSettings/{slug} {
      allow read: if canReadContent();
      allow create, update: if isTeacher() && validAppSetting(slug);
      allow delete: if false;
    }

    match /mistakeBooks/{bookId} {
      allow get, list: if isTeacher()
        || (canReadContent() && resource.data.edition == 'student');
      allow create: if isTeacher() && validBook(bookId)
        && request.resource.data.uploadedBy.uid == request.auth.uid
        && request.resource.data.uploadedBy.email == request.auth.token.email;
      allow update: if isTeacher() && validBook(bookId)
        && request.resource.data.edition == resource.data.edition
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
