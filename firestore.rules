rules_version = '2';

// Generated by npm run rules:build. Edit this template, not firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSchoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches("^[^@]+@(lskc\\.edu\\.hk)$");
    }

    function canReadContent() {
      return true || isSchoolAccount();
    }

    function isTeacher() {
      return isSchoolAccount()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isTeacher()
        && get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.isAdmin == true;
    }

    function validTeacher() {
      return request.resource.data.keys().hasAll(['name', 'isAdmin', 'addedBy', 'addedAt'])
        && request.resource.data.keys().hasOnly(['name', 'isAdmin', 'addedBy', 'addedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.isAdmin is bool
        && request.resource.data.addedBy is string
        && request.resource.data.addedAt is timestamp;
    }

    match /teachers/{email} {
      allow get: if isAdmin() || (isSchoolAccount() && email == request.auth.token.email);
      allow list: if isAdmin();
      allow create: if isAdmin() && email.matches("^[^@]+@(lskc\\.edu\\.hk)$") && validTeacher();
      allow update: if isAdmin() && email.matches("^[^@]+@(lskc\\.edu\\.hk)$") && validTeacher()
        && (email != request.auth.token.email || request.resource.data.isAdmin == true);
      allow delete: if isAdmin() && email != request.auth.token.email;
    }

    match /topics/{topicId} {
      allow read: if canReadContent();
      allow write: if isTeacher();
    }

    match /siteContent/{pageId} {
      allow read: if canReadContent();
      allow write: if isTeacher();
    }

    match /appSettings/{slug} {
      allow read: if canReadContent();
      allow write: if isTeacher();
    }

    match /mistakeBooks/{bookId} {
      allow get, list: if isTeacher()
        || (canReadContent() && resource.data.edition == 'student');
      allow create, update: if isTeacher()
        && request.resource.data.edition in ['student', 'teacher'];
      allow delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
