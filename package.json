{
  "name": "lskc-maths",
  "version": "0.1.0",
  "private": true,
  "description": "Mathematics Department website for S.T.F.A. Lee Shau Kee College",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-lskc-maths",
    "dev:all": "concurrently -n next,firebase -c cyan,yellow -k \"npm:dev\" \"npm:emulators\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:build": "tsx scripts/build-rules.ts",
    "seed": "tsx scripts/seed.ts",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage --project demo-lskc-maths \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "katex": "^0.18.7",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "re2@1.26.1": true
  }
}
