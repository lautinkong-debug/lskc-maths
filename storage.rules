rules_version = '2';

// ---------------------------------------------------------------------------
// PLACEHOLDER - Phase 0.
//
// From Phase 2 onward this file is GENERATED by `npm run rules:build` from
// rules/storage.rules.template. Do not hand-edit it after that.
//
// Until then it denies everything, which is the safe default.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
