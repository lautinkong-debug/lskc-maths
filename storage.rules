rules_version = '2';

// Generated by npm run rules:build. Edit this template, not storage.rules.
service firebase.storage {
  match /b/{bucket}/o {
    function isSchoolAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches("^[^@]+@(lskc\\.edu\\.hk)$");
    }

    function canReadContent() {
      return true || isSchoolAccount();
    }

    function isTeacher() {
      return isSchoolAccount()
        && firestore.exists(/databases/(default)/documents/teachers/$(request.auth.token.email));
    }

    match /mistake-books/{edition}/{bookId}/{fileName} {
      allow get: if isTeacher() || (edition == 'student' && canReadContent());
      allow list: if false;
      allow create, update: if isTeacher()
        && edition in ['student', 'teacher']
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'text/html'
        ];
      allow delete: if isTeacher();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
