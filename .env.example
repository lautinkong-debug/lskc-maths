# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is never committed to git. This example file is.
#
# Everything here starts with NEXT_PUBLIC_, which means it is sent to the
# browser. That is correct and safe: a Firebase web config is public by design.
# The real protection is in firestore.rules and storage.rules.
# -----------------------------------------------------------------------------

# --- Local development ---------------------------------------------------
# true  = talk to the Firebase Emulator Suite on this computer (safe to break)
# false = talk to the real Firebase project
NEXT_PUBLIC_USE_EMULATORS=true

# --- Who can read the site -----------------------------------------------
# public = anyone, no sign-in needed (current setting)
# school = only verified accounts on NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS
# After changing this you MUST run `npm run rules:build` and redeploy rules.
NEXT_PUBLIC_ACCESS_MODE=public

# --- Who can sign in as a teacher ----------------------------------------
# Comma-separated list, no spaces. Also gates reading when ACCESS_MODE=school.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=lskc.edu.hk

# --- Firebase web config --------------------------------------------------
# Find these in the Firebase console:
#   Project settings (gear icon) -> General -> Your apps -> Web app -> Config
# While NEXT_PUBLIC_USE_EMULATORS=true the demo values below are enough.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-lskc-maths.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-lskc-maths
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-lskc-maths.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
